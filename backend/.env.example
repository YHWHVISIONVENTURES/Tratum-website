PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tratum
DB_USER=tratum_app
DB_PASSWORD=replace-me
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_UI_ORIGIN=http://localhost:5173
PORTAL_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional outgoing webhooks: securely generated 32-byte key in lowercase hex.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ALLOWED_HOSTS=
# Provisioning requires an operator-managed P-256 signing key and matching certificate.
TRATUM_ROOT_CA_PRIVATE_KEY_PATH=C:/secure/tratum/root-ca-private.pem
TRATUM_ROOT_CA_CERTIFICATE_PATH=C:/secure/tratum/root-ca-certificate.pem
